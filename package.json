{
  "name": "python-logic-checker",
  "displayName": "Python Logic Checker",
  "publisher": "logic-checker-python",
  "description": "Detección inteligente de errores lógicos en Python mediante IA (Diplomado).",
  "version": "1.1.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuisPastoDev/python-logic-checker"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Python Logic Checker",
      "properties": {
        "pythonLogicChecker.openRouterApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for OpenRouter (https://openrouter.ai/)"
        },
        "pythonLogicChecker.aiProvider": {
          "type": "string",
          "enum": [
            "Ollama (Local)",
            "OpenRouter (Cloud)"
          ],
          "default": "Ollama (Local)",
          "description": "Selecciona qué proveedor de IA usar para el análisis."
        },
        "pythonLogicChecker.ollamaModel": {
          "type": "string",
          "default": "phi3",
          "description": "Nombre del modelo de Ollama que deseas usar (ej. llama3, phi3, qwen:0.5b)."
        },
        "pythonLogicChecker.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "URL base de tu servidor local de Ollama."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
